# Copie este arquivo para `deploy.env` (NÃO versionado — está no .gitignore) e
# preencha. O deploy.sh / deploy.ps1 carregam ele automaticamente antes do clone.
#
# É AQUI que vai a "key do GitHub": use um Personal Access Token (PAT) com escopo
# `repo` embutido na URL HTTPS do repositório privado.

AURORA_REPO_URL=https://SEU_TOKEN_AQUI@github.com/projetoaurora41-cloud/Projeto-Aurora.git

# Alternativa via SSH (a chave privada fica em ~/.ssh/, a pública é uma Deploy key):
# AURORA_REPO_URL=git@github.com:projetoaurora41-cloud/Projeto-Aurora.git

# Opcionais:
# AURORA_DIR=Projeto-Aurora
# AURORA_BRANCH=main
