PGHOST=localhost
PGPORT=5432
PGDATABASE=Aurola
PGUSER=postgres
PGPASSWORD=change-me
CHATTIME_MODEL=ChengsenWang/ChatTime-1-7B-Chat

# Chave da API Anthropic (Claude) — usada pelo juiz LLM "Claude (Anthropic)"
# do benchmark. O juiz referencia ${ANTHROPIC_API_KEY}; a chave fica só aqui.
# Gere em https://console.anthropic.com/ (Settings -> API Keys).
ANTHROPIC_API_KEY=

# Chave da API Gemini (Google) — usada pelo juiz LLM "Gemini (Google)".
# O juiz referencia ${GEMINI_API_KEY}. Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Chat Dados SINAN (RAG + SQL) — Marcelo West ===
# Por padrão usa o MESMO banco do projeto (PG* acima). Defina as SINAN_DB_*
# abaixo SOMENTE se a view do SINAN viver em outro PostgreSQL.
# SINAN_DB_HOST=localhost
# SINAN_DB_PORT=5432
# SINAN_DB_NAME=Aurola
# SINAN_DB_USER=postgres
# SINAN_DB_PASSWORD=
SINAN_VIEW_ORIGEM=view_violencia_chatbot
SINAN_TABELA_SENTENCAS=sentencas_violencia_chatbot
# Busca vetorial (pgvector). Embeddings locais via sentence-transformers.
# CPU por padrão (a GPU pode estar instável); use cuda só se a placa estiver ok.
SINAN_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SINAN_EMBED_DEVICE=cpu
# Chaves de LLM padrão (opcional — também podem ser informadas na UI por sessão).
# OPENAI_API_KEY e PERPLEXITY_API_KEY são lidas do ambiente como fallback.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
PERPLEXITY_MODEL=sonar-pro
# === LLM do chat (Aurora Responde: SÓ Jurema) ===
# O Jurema-7B (via Ollama) é o ÚNICO LLM: redige TODAS as respostas. Não há mais
# orquestrador Qwen3. Baixe-o uma vez com:
#   ollama pull hf.co/rlmoura/Jurema-7B-Q4_K_M-GGUF
#   ollama cp hf.co/rlmoura/Jurema-7B-Q4_K_M-GGUF jurema-7b
JUREMA_MODEL=jurema-7b
OLLAMA_MODEL=jurema-7b
# Tokens máximos da resposta do Jurema (narrativa). Default 520.
# JUREMA_NUM_PREDICT=520
# Último ano com dados na base (o roteador não projeta além disso). Default 2024.
# AURORA_MAX_DATA_YEAR=2024

# === Chat Dados Jurídicos (Eduardo) — Ollama local ===
# Host do Ollama usado pela detecção de modelos locais (página "Modelos").
# Padrão local; aponte para o host/container correto se o Ollama estiver remoto
# (ex.: http://diinftic-es01:11434).
OLLAMA_HOST=http://127.0.0.1:11434

# === Guardrails + Valkey (cache / rate limit) ===
# No docker compose o serviço web já define VALKEY_URL=redis://valkey:6379/0.
# Dev no host: suba só o Valkey (`docker compose up -d valkey`) e use:
# VALKEY_URL=redis://127.0.0.1:6379/0
# Sem VALKEY_URL o Django usa LocMemCache (ok para dev; limites não persistem
# entre processos).
VALKEY_URL=
# Limite de caracteres por mensagem do usuário (encaminhamento 27).
AURORA_MAX_INPUT_CHARS=2000
# Rate limit do Aurora Responde por sessão (encaminhamento 25) — usado por
# guardrails.limites quando o chat for plugado.
GUARDRAILS_RATE_LIMIT_PER_MIN=10
GUARDRAILS_RATE_LIMIT_PER_DAY=200
# Encaminhamento 26 — score de injecção (bloqueia se >= limiar) e limiar de
# divulgação estatística na prosa da resposta.
GUARDRAILS_INJECTION_THRESHOLD=0.70
GUARDRAILS_SUPPRESS_BELOW=5
# Scripts SQL do pacote oficial (se houver drop-in) vão em webapp/guardrails/sql/
# — ver docs/guardrails_integracao.md.
